        "from datetime import datetime\n",
        "from zoneinfo import ZoneInfo\n",
        "\n",
        "days_ms = [\"Isnin\", \"Selasa\", \"Rabu\", \"Khamis\", \"Jumaat\", \"Sabtu\", \"Ahad\"]\n",
        "months_ms = [\"Januari\", \"Februari\", \"Mac\", \"April\", \"Mei\", \"Jun\",\n",
        "             \"Julai\", \"Ogos\", \"September\", \"Oktober\", \"November\", \"Disember\"]\n",
        "\n",
        "user = input(\"Hi! How can I help you? / Apa yang boleh saya bantu? \").lower()\n",
        "now = datetime.now(ZoneInfo(\"Asia/Kuala_Lumpur\"))\n",
        "\n",
        "# English\n",
        "if \"weather\" in user:\n",
        "    print(\"The weather today is sunny!\")\n",
        "elif \"time\" in user:\n",
        "    print(\"The current time is\", now.strftime(\"%I:%M %p\"))\n",
        "elif \"date\" in user:\n",
        "    print(\"Today's date is\", now.strftime(\"%A, %d %B %Y\"))\n",
        "\n",
        "# Malay\n",
        "elif \"cuaca\" in user:\n",
        "    print(\"Cuaca hari ini cerah!\")\n",
        "elif \"masa\" in user or \"waktu\" in user or \"pukul\" in user or \"jam\" in user:\n",
        "    print(\"Masa sekarang ialah\", now.strftime(\"%I:%M %p\"))\n",
        "elif \"tarikh\" in user or \"tanggal\" in user:\n",
        "    print(f\"Tarikh hari ini ialah {days_ms[now.weekday()]}, {now.day} {months_ms[now.month - 1]} {now.year}\")\n",
        "\n",
        "else:\n",
        "    print(\"Sorry, I don't understand. / Maaf, saya tidak faham.\")"
      ]
    }
